FACTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/stock_factor
# 市场数据唯一事实源 = quant（设计文档 §4.1/§12/§76）
MARKET_DATA_SERVICE_URL=http://quant:8011
QUANT_SERVICE_URL=http://quant:8011
CONTENT_SERVICE_URL=http://stock-content:8100
# Runtime profile defaults to a safe non-local authority. Set prod/staging
# only with the real Quant capability checksum and an explicit production URL.
FACTOR_RUNTIME_PROFILE=dev
FACTOR_PAPER_AUTHORITY=quant
ALLOW_LOCAL_PAPER=false
FACTOR_REQUIRED_QUANT_CONTRACT=paper-account.v1
FACTOR_REQUIRED_QUANT_CHECKSUM=
FACTOR_REQUIRED_CONTENT_CONTRACT=content-factor-signal.v5.1
FACTOR_REQUIRED_CONTENT_CHECKSUM=
FACTOR_LIBRARY_BACKEND=yaml
FACTOR_LIBRARY_PATH=/data/factors/factor_library.yaml
FACTOR_SERVICE_PORT=8200
FACTOR_JOB_LEASE_SECONDS=900
FACTOR_WORKER_POLL_SECONDS=2
FACTOR_MODEL_URL=
FACTOR_MODEL_NAME=
