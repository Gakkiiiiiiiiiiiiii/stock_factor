{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-artifact.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "model_id",
    "artifact_id",
    "record_id",
    "checkpoint_sha256",
    "feature_schema_hash",
    "label_schema_hash",
    "training_snapshot_id",
    "split_manifest_hash",
    "reliability_report_hash",
    "dependency_lock_hash",
    "hardware_profile",
    "determinism_profile",
    "created_at",
    "status",
    "producer",
    "reliability_seal",
    "model_version",
    "model_hash",
    "model_artifact_id",
    "reliability_gate"
  ],
  "properties": {
    "contract_version": {"const": "model-artifact.v1"},
    "model_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "training_snapshot_id": {"type": "string", "minLength": 1},
    "split_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reliability_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_lock_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hardware_profile": {"type": "object", "required": ["device"], "properties": {"device": {"enum": ["cpu", "cuda"]}}},
    "determinism_profile": {
      "type": "object",
      "required": ["seed", "deterministic_algorithms", "tolerance_abs", "tolerance_rel"],
      "properties": {
        "seed": {"type": "integer"},
        "deterministic_algorithms": {"type": "boolean"},
        "tolerance_abs": {"type": "number", "minimum": 0},
        "tolerance_rel": {"type": "number", "minimum": 0}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["CANDIDATE", "EVALUATED", "SEALED", "PROMOTED", "RETIRED"]},
    "producer": {"const": "stock_factor"},
    "reliability_seal": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["NOT_EVALUATED", "PASS", "FAIL"]}, "mode": {"type": "string"}}},
    "model_artifact_id": {"type": "string", "minLength": 1},
    "model_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "model_version": {"type": "string", "minLength": 1},
    "reliability_gate": {"type": "object", "required": ["passed"], "properties": {"passed": {"type": "boolean"}}}
  }
}
