{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-artifact.v2",
  "title": "Immutable formal research artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "artifact_id", "artifact_status", "experiment_id",
    "research_question", "hypothesis", "dataset_manifest", "market_ref",
    "content_ref", "candidate_set_hash", "statistical_experiment",
    "final_oos_evidence", "tradability_assessment", "promotion_decision",
    "promotion_policy_version", "producer_commit", "dependency_lock_hash",
    "contract_checksums", "created_at"
  ],
  "properties": {
    "contract_version": {"const": "research-artifact.v2"},
    "artifact_id": {"type": "string", "minLength": 64, "maxLength": 64},
    "artifact_status": {"const": "SEALED"},
    "experiment_id": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "dataset_manifest": {"type": "object", "minProperties": 1},
    "market_ref": {"type": "object", "minProperties": 1},
    "content_ref": {"type": "object", "minProperties": 1},
    "candidate_set_hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "statistical_experiment": {
      "type": "object",
      "required": ["multiple_testing", "dsr", "pbo"]
    },
    "final_oos_evidence": {
      "type": "object",
      "required": ["status", "cohort_artifact_hash", "run_id"],
      "properties": {
        "status": {"const": "SEALED"},
        "cohort_artifact_hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "tradability_assessment": {
      "type": "object",
      "required": ["formal_eligible", "gate_result"],
      "properties": {"formal_eligible": {"type": "boolean"}, "gate_result": {"type": "object", "required": ["passed"]}},
      "anyOf": [
        {"required": ["reference"]},
        {"required": ["evidence"]},
        {"required": ["assessment_ref"]},
        {"required": ["artifact_id"]}
      ]
    },
    "promotion_decision": {
      "type": "object",
      "required": ["passed"],
      "properties": {"passed": {"type": "boolean"}}
    },
    "promotion_policy_version": {"type": "string", "minLength": 1},
    "producer_commit": {"type": "string", "minLength": 1},
    "dependency_lock_hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "contract_checksums": {
      "type": "object", "minProperties": 1,
      "required": ["factor.v1", "market-snapshot.v1", "content-factor-signal.v5.1", "research-artifact.v2"],
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "readiness_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "runtime_profile", "checks", "blocking_reasons", "threshold_version", "frozen_at", "evidence_hash"],
      "properties": {
        "ready": {"type": "boolean"},
        "runtime_profile": {"type": "string", "minLength": 1},
        "checks": {"type": "object"},
        "blocking_reasons": {"type": "array"},
        "threshold_version": {"type": "string", "minLength": 1},
        "frozen_at": {"type": "string", "format": "date-time"},
        "evidence_hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}
      }
    },
    "factor_set": {
      "type": "object",
      "required": ["factors"],
      "properties": {"factors": {"type": "array", "minItems": 1}}
    }
  }
}
